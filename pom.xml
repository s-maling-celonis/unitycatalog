  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>
    <maven.compiler.testRelease>${maven.compiler.release}</maven.compiler.testRelease>

    <scala.version>2.13.17</scala.version>
    <scala.binary.version>2.13</scala.binary.version>

    <spark.version>4.1.3</spark.version>
    <spark.short.version>4.1</spark.short.version>
    <spark.artifact.suffix>_4.1</spark.artifact.suffix>
    <!-- Shim dirs mirror project/spark-versions.json: one version-specific dir plus one
         dir shared with the adjacent Spark line. -->
    <spark.shim.dir>scala-shims/spark-4.1</spark.shim.dir>
    <spark.shim.shared.dir>scala-shims/spark-4.1-4.2</spark.shim.shared.dir>
    <!-- Consumed only by connectors/spark; must not be maven.compiler.testRelease, which
         would apply to every module and break test code that needs Java 17. -->
    <spark.test.release>11</spark.test.release>
    <delta.version>4.3.1</delta.version>
    <!-- Spark 4.0/4.1 publish delta-spark_<short>_<scala>; Spark 4.2+ uses unsuffixed delta-spark_<scala>. -->
    <delta.spark.artifactId>delta-spark_${spark.short.version}_${scala.binary.version}</delta.spark.artifactId>
    <hadoop.version>3.4.2</hadoop.version>
    <iceberg.version>1.11.0</iceberg.version>
    <jackson.version>2.18.9</jackson.version>
    <jackson.spark.version>2.21.2</jackson.spark.version>
    <jackson.spark.annotations.version>2.21</jackson.spark.annotations.version>
    <log4j.version>2.25.5</log4j.version>
    <slf4j.version>2.0.13</slf4j.version>
    <junit.version>5.10.3</junit.version>
    <mockito.version>5.20.0</mockito.version>
    <lombok.version>1.18.42</lombok.version>
    <armeria.version>1.41.0</armeria.version>
    <!-- Armeria 1.41 ships Netty 4.2.16; keep the BOM and tcnative on the 4.2.17 line.
         4.2.17's OpenSSL engine calls SSL.getGroupName, which exists only in tcnative 2.0.81+.
         azure-core-http-netty otherwise wins with tcnative-classes 2.0.65 and the Azure
         credential test hangs on Linux/macOS after a NoSuchMethodError in the event loop. -->
    <netty.version>4.2.17.Final</netty.version>
    <netty.tcnative.version>2.0.81.Final</netty.tcnative.version>
    <httpclient.version>4.5.14</httpclient.version>
    <openapi.jackson.nullable.version>0.2.11</openapi.jackson.nullable.version>
    <python.package.version>0.7.0.dev0</python.package.version>
    <checkstyle.version>9.3</checkstyle.version>
    <checkstyle.config>${maven.multiModuleProjectDirectory}/dev/checkstyle-config.xml</checkstyle.config>
    <checkstyle.skip>false</checkstyle.skip>

    <openapi-generator-maven-plugin.version>7.9.0</openapi-generator-maven-plugin.version>
    <spotless.version>2.44.4</spotless.version>
    <jacoco.version>0.8.13</jacoco.version>
    <argLine></argLine>
  </properties>

